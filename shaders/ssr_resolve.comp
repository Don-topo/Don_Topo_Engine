#version 450

layout(local_size_x = 8, local_size_y = 8) in;

// Isolated reflection that ssr.comp left.
layout(set = 0, binding = 0) uniform sampler2D srcTex;
// Unused here: the descriptor set layout is the SAME as ssr.comp's (a
// single layout, a single pipeline layout, a single pool), and this pipeline
// simply does not read this binding.
layout(set = 0, binding = 1) uniform sampler2D depthTex;
// The HDR scene, this time as storage: the SAME texel is read and rewritten, so
// no race is possible between invocations. It goes before the bloom on purpose:
// the reflection has to go through the bloom threshold and the ACES tonemap just
// like the rest of the image.
layout(set = 0, binding = 2, rgba16f) uniform image2D outHdr;

layout(push_constant) uniform SsrPush {
    vec4  projParams;
    vec2  invRes;
    float maxDistance;
    float thickness;
    int   maxSteps;
    int   refineSteps;
    float edgeFade;
    float intensity;
} push;

void main()
{
    ivec2 px   = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outHdr);
    if (px.x >= size.x || px.y >= size.y) return;

    vec3 refl = texelFetch(srcTex, px, 0).rgb;
    vec4 hdr  = imageLoad(outHdr, px);
    // The alpha is kept as is (it carries the object's SSR mask). Nobody reads
    // it after this point, but rewriting it to something else would be lying about
    // the image's content.
    imageStore(outHdr, px, vec4(hdr.rgb + refl, hdr.a));
}
