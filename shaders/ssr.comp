#version 450

layout(local_size_x = 8, local_size_y = 8) in;

// Scene color ALREADY lit and NOT tonemapped (m_hdrImage). The alpha is NOT
// opacity: pbr.frag writes the object's SSR strength there (push.flags.y), which
// is how the per-object mask reaches here without an extra attachment.
layout(set = 0, binding = 0) uniform sampler2D sceneTex;
// Depth of the WHOLE scene, from the same depth pre-pass that feeds SSAO.
// NEAREST: linear filtering on D32_SFLOAT is not mandatory in Vulkan.
layout(set = 0, binding = 1) uniform sampler2D depthTex;
// Isolated reflection. It is not added here onto the HDR on purpose: this shader reads
// ARBITRARY pixels of sceneTex, so writing to that same image would be
// a race with the other invocations. The sum is done by ssr_resolve.comp, which
// is strictly 1:1.
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D outSsr;

// Specific to this pipeline, like SsaoPush: the UBO block is declared in 5
// shaders and adding a member would silently shift everything behind it under
// std140, and PushData is full at exactly 80 bytes.
layout(push_constant) uniform SsrPush {
    // p00, p11, p22, p32 of the frame's projection, the same one the depth was
    // recorded with. The sign of p11 is irrelevant: see the note in ssao.comp,
    // which explains why it cancels out and why it must not be "fixed".
    vec4  projParams;
    vec2  invRes;
    float maxDistance;   // ray reach in view space units
    float thickness;     // assumed thickness of what is in the depth buffer
    int   maxSteps;
    int   refineSteps;   // binary search over the last segment
    float edgeFade;      // fraction of the screen where the reflection fades out
    float intensity;     // global multiplier
} push;

// Same two functions as ssao.comp, same derivation:
// depth = (p22*z + p32) / -z  ->  z = p32 / (-depth - p22).
float viewZ(float d)
{
    return push.projParams.w / (-d - push.projParams.z);
}

vec3 viewPos(vec2 uv, float d)
{
    float z   = viewZ(d);
    vec2  ndc = uv * 2.0 - 1.0;
    return vec3(ndc.x * (-z) / push.projParams.x,
                ndc.y * (-z) / push.projParams.y,
                z);
}

// view space -> framebuffer uv. clip.w = -z.
vec2 projectUv(vec3 p)
{
    vec2 clipXy = vec2(p.x * push.projParams.x, p.y * push.projParams.y);
    return (clipXy / -p.z) * 0.5 + 0.5;
}

void main()
{
    ivec2 px   = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outSsr);
    if (px.x >= size.x || px.y >= size.y) return;

    imageStore(outSsr, px, vec4(0.0));

    vec2 uv = (vec2(px) + 0.5) * push.invRes;

    // Background (skybox or clear): there is no surface to reflect, and the reconstruction
    // divides by zero right there.
    float d = texture(depthTex, uv).r;
    if (d >= 1.0) return;

    // Per-object mask. Zero = this pixel does not reflect: it exits before marching
    // anything, which is what makes a scene without marked objects cost nothing.
    vec4  scene = texture(sceneTex, uv);
    float mask  = scene.a;
    if (mask <= 0.0) return;

    vec3 P = viewPos(uv, d);

    // Normal reconstructed from the depth itself, exactly as in ssao.comp:
    // of the two neighbors on each axis it keeps the one with the smaller depth
    // jump, which is the one still on the SAME surface. With this there is no
    // need for a normals attachment or to touch the geometry pipelines; the
    // price is that the normal map's detail does not reach here, so a polished
    // metal with a normal map reflects like a flat mirror.
    vec2 tx = vec2(push.invRes.x, 0.0);
    vec2 ty = vec2(0.0, push.invRes.y);
    vec3 pR = viewPos(uv + tx, texture(depthTex, uv + tx).r);
    vec3 pL = viewPos(uv - tx, texture(depthTex, uv - tx).r);
    vec3 pD = viewPos(uv + ty, texture(depthTex, uv + ty).r);
    vec3 pU = viewPos(uv - ty, texture(depthTex, uv - ty).r);

    vec3 dx = (abs(pR.z - P.z) < abs(P.z - pL.z)) ? (pR - P) : (P - pL);
    vec3 dy = (abs(pD.z - P.z) < abs(P.z - pU.z)) ? (pD - P) : (P - pU);

    vec3 N = cross(dx, dy);
    if (dot(N, N) < 1e-12) return;
    N = normalize(N);
    // A visible surface has its geometric normal facing the camera.
    if (dot(N, P) > 0.0) N = -N;

    // In view space the camera is at the origin.
    vec3 V = normalize(-P);
    vec3 R = reflect(-V, N);

    // Rays that come back towards the camera: what they would reflect is BEHIND the
    // viewer, which is exactly what the screen does not contain. They are turned off instead
    // of returning the first spurious hit.
    float towardCamera = clamp(dot(R, V), 0.0, 1.0);
    float backFade     = 1.0 - towardCamera;
    if (backFade <= 0.0) return;

    // ── March in view space, reprojecting each step ───────────────────────
    int   steps    = max(push.maxSteps, 1);
    float stepLen  = push.maxDistance / float(steps);
    float hitT     = -1.0;
    float prevT    = 0.0;
    vec2  hitUv    = vec2(0.0);

    for (int i = 1; i <= steps; i++)
    {
        float t = stepLen * float(i);
        vec3  S = P + R * t;
        if (S.z >= 0.0) break;                  // in front of the camera plane

        vec2 suv = projectUv(S);
        if (suv.x < 0.0 || suv.x > 1.0 || suv.y < 0.0 || suv.y > 1.0) break;

        float sd = texture(depthTex, suv).r;
        if (sd >= 1.0) { prevT = t; continue; } // sky: not a surface

        // In RH view space the camera looks at -Z: closer = greater z. If what is
        // drawn is in front of the sample, the ray has passed through it.
        float diff = viewZ(sd) - S.z;
        if (diff > 0.0 && diff < push.thickness)
        {
            hitT  = t;
            hitUv = suv;
            break;
        }
        prevT = t;
    }

    // Without a hit there is no fallback of its own: pbr.frag already adds the prefiltered
    // cubemap's specular for ALL pixels, so returning something here
    // would be counting the environment twice.
    if (hitT < 0.0) return;

    // ── Refinement: binary search in the segment [prevT, hitT] ────────────────
    // The linear step leaves the hit up to one stepLen past the real contact,
    // which on a floor looks like the reflection detached from the object.
    float lo = prevT;
    float hi = hitT;
    for (int r = 0; r < push.refineSteps; r++)
    {
        float mid = (lo + hi) * 0.5;
        vec3  S   = P + R * mid;
        if (S.z >= 0.0) { hi = mid; continue; }

        vec2 suv = projectUv(S);
        if (suv.x < 0.0 || suv.x > 1.0 || suv.y < 0.0 || suv.y > 1.0) { hi = mid; continue; }

        float sd = texture(depthTex, suv).r;
        if (sd >= 1.0) { lo = mid; continue; }

        float diff = viewZ(sd) - S.z;
        if (diff > 0.0) { hi = mid; hitUv = suv; }
        else            { lo = mid; }
    }
    hitT = hi;

    // ── Attenuations ────────────────────────────────────────────────────────
    // Screen edge: the ray leaves the viewport and the reflection would be cut
    // abruptly against the frame.
    float fadeW = max(push.edgeFade, 1e-4);
    vec2  edge  = smoothstep(vec2(0.0), vec2(fadeW), hitUv)
                * smoothstep(vec2(0.0), vec2(fadeW), 1.0 - hitUv);
    float edgeFade = edge.x * edge.y;

    // Distance: the longer the ray, the less reliable the screen
    // information; it also avoids the hard cut right at maxDistance.
    float distFade = 1.0 - clamp(hitT / max(push.maxDistance, 1e-4), 0.0, 1.0);

    // Schlick's Fresnel with the object's mask acting as F0: with the strength
    // at 1 it is a mirror at any angle, and with low values the reflection rises
    // when looking edge-on, which is how a polished floor or water behaves.
    float NdotV = max(dot(N, V), 0.0);
    float F     = mask + (1.0 - mask) * pow(1.0 - NdotV, 5.0);

    vec3 refl = texture(sceneTex, hitUv).rgb * F * edgeFade * distFade * backFade * push.intensity;
    imageStore(outSsr, px, vec4(refl, 1.0));
}
