#version 450

// TILED Forward+. One workgroup per 16x16 pixel tile of the INTERNAL
// render resolution (m_renderExtent, which with SSAA is not the window's).
// Each invocation reads its texel from the depth pre-pass that recordSsaoPass already records,
// the tile's maximum is reduced and with it the far plane of the tile's
// frustum is trimmed before testing the lights' spheres.
//
// The NEAR plane stays at zNear on purpose, without using the tile's minimum:
// the pre-pass does not draw skinned meshes, so a character in front of the
// static geometry would fall outside the [min, max] range and lose lights. With
// [zNear, tile's max] the bound is correct for EVERY visible fragment: a visible
// skinned one is in front of the static depth of its texel, which
// already enters the maximum.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

// It must match Renderer::kFpMaxLights.
#define FP_MAX_LIGHTS 256
#define FP_MASK_WORDS 8     // FP_MAX_LIGHTS / 32
#define FP_THREADS    256   // local_size_x * local_size_y

struct FpLight
{
    vec4 posRadius;     // xyz world, w radius
    vec4 color;         // rgb color, a intensity
    vec4 viewPosR;      // xyz view space, w radio
    vec4 direction;     // xyz dir, w type (0 point, 1 spot, 2 directional, 3 area)
    vec4 params;        // range, inner cos, outer cos, width
};

layout(std430, set = 0, binding = 0) readonly buffer FpParamsBuf {
    uint  mode;
    uint  gridX;
    uint  gridY;
    uint  gridZ;
    uint  tileSize;
    uint  maxPerCell;
    uint  numLights;
    uint  pad0;
    float zNear;
    float zFar;
    float sliceScale;
    float sliceBias;
} fp;

layout(std430, set = 0, binding = 1) readonly  buffer FpLightBuf { FpLight lights[]; };
layout(std430, set = 0, binding = 2) writeonly buffer FpGridBuf  { uvec2   cells[];  };
layout(std430, set = 0, binding = 3) writeonly buffer FpIndexBuf { uint    indices[]; };
layout(set = 0, binding = 4) uniform sampler2D depthTex;
layout(std430, set = 0, binding = 5) buffer FpStatsBuf { uint stats[]; };

layout(push_constant) uniform FpPush {
    float p00;
    float p11;
    float p22;
    float p32;
    uint  screenW;
    uint  screenH;
    uint  pad0;
    uint  pad1;
} pc;

shared uint s_maxDepth;
shared uint s_mask[FP_MASK_WORDS];

// RH_ZO: d = (p22*z + p32) / -z  with z negative in view space.
float viewDepthFromZ(float d)
{
    return pc.p32 / (d + pc.p22);
}

void main()
{
    uint tileX = gl_WorkGroupID.x;
    uint tileY = gl_WorkGroupID.y;
    if (tileX >= fp.gridX || tileY >= fp.gridY) return;
    uint cell = tileY * fp.gridX + tileX;

    if (gl_LocalInvocationIndex == 0u) s_maxDepth = 0u;
    if (gl_LocalInvocationIndex < uint(FP_MASK_WORDS)) s_mask[gl_LocalInvocationIndex] = 0u;
    barrier();

    ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
    if (texel.x < int(pc.screenW) && texel.y < int(pc.screenH))
    {
        float d  = texelFetch(depthTex, texel, 0).r;
        float vd = clamp(viewDepthFromZ(d), fp.zNear, fp.zFar);
        // The depths are positive: the order of the floats matches that of
        // their bit pattern, so atomicMax over uint works as a maximum.
        atomicMax(s_maxDepth, floatBitsToUint(vd));
    }
    barrier();

    float tileFar = max(uintBitsToFloat(s_maxDepth), fp.zNear);

    // Side planes of the tile in view space. The tile is in pixels of the
    // internal resolution; the last one of each row/column may stick out and is
    // clamped to the screen.
    float ts  = float(fp.tileSize);
    float x0  = float(tileX) * ts;
    float x1  = min(x0 + ts, float(pc.screenW));
    float y0  = float(tileY) * ts;
    float y1  = min(y0 + ts, float(pc.screenH));

    float nx0 = 2.0 * x0 / float(pc.screenW) - 1.0;
    float nx1 = 2.0 * x1 / float(pc.screenW) - 1.0;
    float ny0 = 2.0 * y0 / float(pc.screenH) - 1.0;
    float ny1 = 2.0 * y1 / float(pc.screenH) - 1.0;

    // x = k * viewDepth with k = ndc / p00. p11 arrives NEGATIVE (Vulkan's Y-flip
    // is in the projection), so the two k are ordered with min/max instead
    // of assuming they are already ordered.
    float kxa  = nx0 / pc.p00;
    float kxb  = nx1 / pc.p00;
    float kya  = ny0 / pc.p11;
    float kyb  = ny1 / pc.p11;
    float kxLo = min(kxa, kxb), kxHi = max(kxa, kxb);
    float kyLo = min(kya, kyb), kyHi = max(kya, kyb);

    // With viewDepth = -z, "x >= kxLo*viewDepth" is "x + kxLo*z >= 0".
    vec3 n0 = normalize(vec3( 1.0,  0.0,  kxLo));
    vec3 n1 = normalize(vec3(-1.0,  0.0, -kxHi));
    vec3 n2 = normalize(vec3( 0.0,  1.0,  kyLo));
    vec3 n3 = normalize(vec3( 0.0, -1.0, -kyHi));

    for (uint i = gl_LocalInvocationIndex; i < fp.numLights; i += uint(FP_THREADS))
    {
        vec3  c  = lights[i].viewPosR.xyz;
        float r  = lights[i].viewPosR.w;
        float vd = -c.z;
        // A directional has neither position nor reach: it lights EVERYTHING, so it
        // enters each tile without going through the planes.
        bool inside = (int(lights[i].direction.w + 0.5) == 2)
                   || ((vd + r >= fp.zNear) && (vd - r <= tileFar)
                   && (dot(n0, c) >= -r) && (dot(n1, c) >= -r)
                   && (dot(n2, c) >= -r) && (dot(n3, c) >= -r));
        if (inside) atomicOr(s_mask[i >> 5u], 1u << (i & 31u));
    }
    barrier();

    // A single invocation dumps the mask IN ASCENDING INDEX ORDER. It is what
    // makes the list come out the same as the clustered one's, and with it the sum
    // of lights in the fragment shader: if it were emitted in the order in which the
    // atomics win, the two paths would sum the same terms in a different order.
    if (gl_LocalInvocationIndex == 0u)
    {
        uint base  = cell * fp.maxPerCell;
        uint count = 0u;
        uint total = 0u;
        for (uint w = 0u; w < uint(FP_MASK_WORDS); w++)
        {
            uint bits = s_mask[w];
            total += uint(bitCount(bits));
            while (bits != 0u && count < fp.maxPerCell)
            {
                uint b = uint(findLSB(bits));
                bits &= ~(1u << b);
                indices[base + count] = (w << 5u) + b;
                count++;
            }
        }
        cells[cell] = uvec2(base, count);

        if (count > 0u)
        {
            atomicAdd(stats[0], count);
            atomicAdd(stats[1], 1u);
        }
        if (total > fp.maxPerCell) atomicAdd(stats[2], 1u);
    }
}
