#version 450

// One level of the upsample chain: reads mip N (already filtered) with a 3x3 tent
// and ADDS it onto mip N-1, which already contains what the downsample left. That is why
// dstImg is not writeonly: imageLoad is needed to accumulate. The format
// qualifier (rgba16f) is what allows reading it without requiring
// shaderStorageImageReadWithoutFormat.
layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D srcTex;
layout(set = 0, binding = 1, rgba16f) uniform image2D dstImg;

layout(push_constant) uniform Push {
    vec2  srcTexel;   // 1 / size of the SOURCE level (the small mip)
    float threshold;  // unused here
    float knee;       // unused here
    float radius;     // tent spacing, in source texels
    int   prefilter;  // unused here
} push;

vec3 tap(vec2 uv, vec2 off)
{
    return texture(srcTex, uv + off * push.srcTexel * push.radius).rgb;
}

void main()
{
    ivec2 dstSize  = imageSize(dstImg);
    ivec2 dstCoord = ivec2(gl_GlobalInvocationID.xy);
    if (dstCoord.x >= dstSize.x || dstCoord.y >= dstSize.y) return;

    vec2 uv = (vec2(dstCoord) + 0.5) / vec2(dstSize);

    // 3x3 tent (1 2 1 / 2 4 2 / 1 2 1) / 16.
    vec3 sum = tap(uv, vec2(-1.0, -1.0)) * 1.0
             + tap(uv, vec2( 0.0, -1.0)) * 2.0
             + tap(uv, vec2( 1.0, -1.0)) * 1.0
             + tap(uv, vec2(-1.0,  0.0)) * 2.0
             + tap(uv, vec2( 0.0,  0.0)) * 4.0
             + tap(uv, vec2( 1.0,  0.0)) * 2.0
             + tap(uv, vec2(-1.0,  1.0)) * 1.0
             + tap(uv, vec2( 0.0,  1.0)) * 2.0
             + tap(uv, vec2( 1.0,  1.0)) * 1.0;
    sum *= 1.0 / 16.0;

    vec3 dst = imageLoad(dstImg, dstCoord).rgb;
    imageStore(dstImg, dstCoord, vec4(dst + sum, 1.0));
}
