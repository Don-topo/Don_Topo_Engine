#version 450

// Diffuse convolution of the environment cubemap. One invocation per texel of the
// face; the stored result is NOT the irradiance E, but E/PI, that is,
// the mean radiance. That way pbr.frag does `albedo * irradiance` plainly, without
// carrying the 1/PI of the Lambertian BRDF.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform samplerCube envMap;
// image2DArray and not imageCube: writing a cubemap as a storage image requires
// capabilities that are not needed, and the image is created CUBE_COMPATIBLE, so
// the same memory is seen as an array of 6 layers.
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2DArray outCube;

layout(push_constant) uniform Push {
    float roughness;   // unused here; the layout is shared by the two shaders
    uint  faceSize;
    // Weight of the result. It is 1.0 in the global IBL (image identical to before
    // this field existed) and the probe's intensity when this convolves the
    // capture of a reflection probe: baking it in here is what allows having
    // intensity PER probe without a new field in the UBO block.
    float intensity;
} pc;

const float PI = 3.14159265359;
const uint  SAMPLE_COUNT = 2048u;

// World direction of texel (x, y) of face `face`, with u,v in [-1,1].
// It is the exact inverse of the mapping the hardware uses when sampling a samplerCube
// (OpenGL/Vulkan convention), so that input and output are aligned.
vec3 dirFromFace(uint face, vec2 uv)
{
    float u = uv.x;
    float v = uv.y;
    if (face == 0u) return vec3( 1.0,   -v,   -u);  // +X
    if (face == 1u) return vec3(-1.0,   -v,    u);  // -X
    if (face == 2u) return vec3(   u,  1.0,    v);  // +Y
    if (face == 3u) return vec3(   u, -1.0,   -v);  // -Y
    if (face == 4u) return vec3(   u,   -v,  1.0);  // +Z
    return                 vec3(  -u,   -v, -1.0);  // -Z
}

// Van der Corput in base 2: the low-discrepancy half of Hammersley.
float radicalInverse(uint bits)
{
    bits = (bits << 16u) | (bits >> 16u);
    bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
    bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
    bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
    bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
    return float(bits) * 2.3283064365386963e-10;
}

vec2 hammersley(uint i, uint n)
{
    return vec2(float(i) / float(n), radicalInverse(i));
}

void main()
{
    uvec3 gid = gl_GlobalInvocationID;
    if (gid.x >= pc.faceSize || gid.y >= pc.faceSize) return;

    vec2 uv = (vec2(gid.xy) + 0.5) / float(pc.faceSize) * 2.0 - 1.0;
    vec3 N  = normalize(dirFromFace(gid.z, uv));

    // Arbitrary tangent basis around N. The auxiliary axis is switched near
    // the poles because cross(N, up) degenerates when they are parallel.
    vec3 up      = abs(N.z) < 0.999 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3 tangent = normalize(cross(up, N));
    vec3 bitan   = cross(N, tangent);

    // Importance sampling with pdf = cos(theta)/PI: the estimator of
    // E = integral(L * cos) comes out as PI * mean(L), and since what is stored is
    // E/PI, the result is plainly the mean of L.
    vec3 sum = vec3(0.0);
    for (uint i = 0u; i < SAMPLE_COUNT; i++)
    {
        vec2  xi    = hammersley(i, SAMPLE_COUNT);
        float phi   = 2.0 * PI * xi.x;
        float cosT  = sqrt(1.0 - xi.y);   // xi.y = sin^2(theta)
        float sinT  = sqrt(xi.y);
        vec3  local = vec3(sinT * cos(phi), sinT * sin(phi), cosT);
        vec3  L     = tangent * local.x + bitan * local.y + N * local.z;
        sum += textureLod(envMap, L, 0.0).rgb;
    }

    vec3 irradiance = sum / float(SAMPLE_COUNT);
    imageStore(outCube, ivec3(gid), vec4(irradiance * pc.intensity, 1.0));
}
