#version 450

// CAMERA motion blur by reprojection. It runs after the fog and before
// the bloom: the trail drags the highlights and blooms with them, just as
// SSR does.
//
// Each pixel's velocity comes from the same matrix that TAA already uses
// (prevViewProj * inverse(currViewProj)) applied to the pre-pass depth. That
// covers the camera's motion (translation and rotation), which is the one that generates
// almost all the visible trail. Objects that move BY THEMSELVES contribute
// no velocity of their own: it would take a velocity buffer with each object's
// previous matrix (and the previous bones of the skinned meshes), which is
// another attachment in the scene pass. Here there is no new per-object state.
layout(local_size_x = 8, local_size_y = 8) in;

// The already lit HDR scene, as a texture: this shader reads ARBITRARY pixels
// along the velocity, so it cannot write to the same image. The
// alpha is NOT opacity (pbr.frag stores the object's SSR strength there) and
// that is why it is copied without blending.
layout(set = 0, binding = 0) uniform sampler2D sceneTex;
// Depth of the WHOLE scene, from the same depth pre-pass that feeds SSAO,
// SSR and TAA. NEAREST: D32_SFLOAT is not guaranteed to support linear filtering.
layout(set = 0, binding = 1) uniform sampler2D depthTex;
// Destination: intermediate image of the same format and size as the scene. The
// backend copies it back onto the HDR when the pass finishes.
layout(set = 0, binding = 2, rgba16f) uniform writeonly image2D outImage;

// Specific to this pipeline, like SsrPush and FogPush: the UBO block is
// declared in several shaders and adding a member would silently shift everything
// behind it under std140.
layout(push_constant) uniform MotionBlurPush {
    // Clip of THIS frame (without jitter) -> clip of the previous one. It is computed on the CPU
    // as prevViewProj * inverse(currViewProj), exactly as in TAA.
    mat4  reproject;
    vec2  invRes;
    float intensity;   // velocity scale; 1.0 = displacement of one frame
    float maxRadius;   // cap of the trail in pixels, so that a sharp turn does not
                       // smear half the screen
    int   samples;     // taps spread along the velocity
} push;

void main()
{
    ivec2 px   = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outImage);
    if (px.x >= size.x || px.y >= size.y) return;

    vec2 uv     = (vec2(px) + 0.5) * push.invRes;
    vec4 center = texture(sceneTex, uv);

    // Reprojection: from (uv, depth) of this frame to the uv that this same point occupied in the
    // previous one. The depth comes from the pre-pass, which is recorded WITHOUT jitter, so the
    // reconstructed position is the geometric one.
    float depth = texture(depthTex, uv).r;
    vec4  clip  = vec4(uv * 2.0 - 1.0, depth, 1.0);
    vec4  prev  = push.reproject * clip;

    // Degenerate w in the far background: no reprojection is valid, the pixel is left
    // as is instead of dividing by almost zero.
    if (abs(prev.w) < 1e-6)
    {
        imageStore(outImage, px, center);
        return;
    }

    vec2 prevUv = (prev.xy / prev.w) * 0.5 + 0.5;

    // From the current pixel to the previous one. The sign makes the trail go BEHIND
    // the motion, which is where the pixel was.
    vec2 velocity = (prevUv - uv) * push.intensity;

    // Cap in pixels. Without this a fast camera turn turns the trail into
    // a full-screen sweep and the cost shoots up due to the cache.
    vec2  velPx = velocity / max(push.invRes, vec2(1e-8));
    float lenPx = length(velPx);
    if (lenPx > push.maxRadius && lenPx > 1e-6)
        velocity *= push.maxRadius / lenPx;

    // Below half a pixel there is nothing to blur: the average would give the
    // same color but at the cost of N samples.
    const int taps = max(push.samples, 1);
    if (lenPx < 0.5 || taps < 2)
    {
        imageStore(outImage, px, center);
        return;
    }

    // Uniform sampling CENTERED on the pixel: half of the taps fall where the
    // point was and the other half where it is going. Centering avoids the whole image
    // looking shifted backwards when the camera moves at constant
    // speed.
    vec3 sum = vec3(0.0);
    for (int i = 0; i < taps; i++)
    {
        float t = float(i) / float(taps - 1) - 0.5;
        sum += texture(sceneTex, uv + velocity * t).rgb;
    }

    // The alpha is kept without blending: it carries the object's SSR mask, which is not
    // a quantity that makes sense to average across different pixels.
    imageStore(outImage, px, vec4(sum / float(taps), center.a));
}
