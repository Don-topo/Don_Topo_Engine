#version 450

// Exponential height volumetric fog with in-scattering from the key light.
// It runs AFTER the scene pass and the SSR and BEFORE the bloom, so that the
// contribution blooms and tonemaps like the rest of the image.

#include "shadow_config.glsl"
// Shadow matrix slots. The first 6 belong to the KEY light (4 cascades,
// or 6 cubemap faces, or 1 spot face); the 4 after them are one secondary
// spot each. Same value as SHADOW_MATRICES in
// UniformBufferObject.h.
#include "lights_config.glsl"
#define PI 3.14159265359

// Same layout as DonTopo::Light and as the pbr.frag declaration.
struct Light { vec4 position; vec4 color; vec4 direction; vec4 params; };

layout(local_size_x = 8, local_size_y = 8) in;

// The offscreen HDR (rgba16f) is read and rewritten IN PLACE: each invocation
// touches only its own pixel, so there is no race like the one that forces SSR to
// go through an intermediate image. The alpha is NOT opacity (pbr.frag stores the
// object's SSR strength there) and that is why it is copied as is.
layout(set = 0, binding = 0, rgba16f) uniform image2D hdrImage;
// Depth of the WHOLE scene, from the same depth pre-pass that feeds SSAO
// and SSR. NEAREST: D32_SFLOAT is not guaranteed to support linear filtering.
layout(set = 0, binding = 1) uniform sampler2D depthTex;
// The frame's UBO block, declared ONLY up to lights: the members that come
// after (viewPos, numLights, ambientIntensity) are not used here and omitting them
// does not move a single offset, because std140 places them all AFTER. From here come
// the view matrix (view space depth to choose the cascade), the key light's
// shadow matrices, and the key light itself.
//
// lights is included although of the whole array only lights[0].direction.w is read: the
// key light's TYPE decides how the shadow map is sampled, and that criterion is
// shared with pbr.frag (shadow_lookup.glsl). Putting it in the push constant was not
// an option: it is exactly 128 bytes and they are full.
layout(set = 0, binding = 2) uniform UBO {
    mat4  view;
    mat4  proj;
    mat4  lightSpaceMatrix[SHADOW_MATRICES];
    vec4  cascadeSplits;
    Light lights[MAX_LIGHTS];
} ubo;
layout(set = 0, binding = 3) uniform sampler2DArrayShadow shadowMap;

// Specific to this pipeline, like SsrPush and SsaoPush: the UBO block is
// declared in 6 shaders and adding a member would silently shift everything
// behind it under std140. Exactly 128 bytes, the minimum Vulkan guarantees.
layout(push_constant) uniform FogPush {
    // inverse(proj * view) with the frame's EFFECTIVE projection (Vulkan's Y-flip
    // already inside), the same one the depth was recorded with.
    mat4 invViewProj;
    vec4 camPosDensity;      // xyz = camera in world, w = base density
    vec4 lightDirFalloff;    // xyz = key light direction (from the light towards
                             // the scene), w = falloff by height
    vec4 scatterBaseHeight;  // rgb = scattering color ALREADY multiplied by the
                             // key light's color and intensity, a = reference height of
                             // the density
    vec4 gStepsRes;          // x = HG anisotropy, y = steps, zw = resolution
} push;

// The layer choice and the reprojection are shared with pbr.frag, which samples
// the SAME map. There used to be a copy of the criterion here and that is exactly
// what got out of sync in H65.
#include "shadow_lookup.glsl"

// A single tap, without pbr.frag's 3x3 PCF: here it is sampled N times per pixel
// (once per march step) and the noise a single tap leaves is dissolved by the
// accumulation itself plus the dither. This difference IS deliberate; the one
// above was not.
float shadowAt(vec3 worldPos)
{
    vec3  p;
    float layer;
    // No normal: this point is in the AIR, not on a surface, so
    // there is nothing that can self-shadow and the normal-offset does not apply.
    if (!dtShadowCoord(worldPos, vec3(0.0), p, layer)) return 1.0;
    return texture(shadowMap, vec4(p.xy, layer, p.z));
}

// Henyey-Greenstein. g > 0 = forward scattering: halo around the
// light when looking towards it.
float phaseHG(float cosT, float g)
{
    float g2    = g * g;
    float denom = 1.0 + g2 - 2.0 * g * cosT;
    return (1.0 - g2) / (4.0 * PI * pow(max(denom, 1e-4), 1.5));
}

// Interleaved gradient noise: shifts each pixel's first step by a different
// fraction of the step. Without this, the march with few steps leaves visible
// concentric rings (banding) instead of fog.
float dither(vec2 px)
{
    return fract(52.9829189 * fract(dot(px, vec2(0.06711056, 0.00583715))));
}

void main()
{
    ivec2 px   = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(hdrImage);
    if (px.x >= size.x || px.y >= size.y) return;

    vec2 uv = (vec2(px) + 0.5) / max(push.gStepsRes.zw, vec2(1.0));

    // End point of the march: the surface at that pixel. In the sky
    // (depth = 1) the far plane comes out, which is right for a height
    // fog: the horizon is covered too.
    float d    = texture(depthTex, uv).r;
    vec4  clip = vec4(uv * 2.0 - 1.0, d, 1.0);
    vec4  wpos = push.invViewProj * clip;
    if (abs(wpos.w) < 1e-9) return;
    vec3 endPos = wpos.xyz / wpos.w;

    vec3  camPos  = push.camPosDensity.xyz;
    vec3  seg     = endPos - camPos;
    float rayLen  = length(seg);
    if (rayLen < 1e-4) return;
    vec3 rayDir = seg / rayLen;

    float density     = push.camPosDensity.w;
    vec3  lightDir    = push.lightDirFalloff.xyz;
    float falloff     = push.lightDirFalloff.w;
    vec3  scatterCol  = push.scatterBaseHeight.rgb;
    float baseHeight  = push.scatterBaseHeight.a;
    float g           = push.gStepsRes.x;
    int   steps       = max(int(push.gStepsRes.y), 1);

    // Scattering angle: the light travels along lightDir and goes out
    // towards the camera, that is, along -rayDir. cos(theta) = dot(-rayDir, lightDir)
    // with its sign changed by the double negation.
    float phase = phaseHG(-dot(rayDir, lightDir), clamp(g, -0.95, 0.95));

    float stepLen = rayLen / float(steps);
    float offset  = dither(vec2(px));

    float transmittance = 1.0;
    vec3  scattered     = vec3(0.0);

    for (int i = 0; i < steps; i++)
    {
        vec3 p = camPos + rayDir * ((float(i) + offset) * stepLen);

        // Exponential by height. The exponent is clamped: below the
        // reference height it grows without limit and a very low camera would give
        // inf * 0 = NaN in the accumulation.
        float dens = density * exp(clamp(-(p.y - baseHeight) * falloff, -20.0, 20.0));
        if (dens <= 0.0) continue;

        // Beer-Lambert over the segment, and the energy that is absorbed is exactly
        // what can be scattered towards the camera.
        float stepTrans = exp(-dens * stepLen);
        float absorbed  = 1.0 - stepTrans;

        scattered     += transmittance * absorbed * scatterCol * phase * shadowAt(p);
        transmittance *= stepTrans;

        // Nothing arrives from behind anymore: the rest of the march does not change the pixel.
        if (transmittance < 1e-3) break;
    }

    vec4 hdr = imageLoad(hdrImage, px);
    imageStore(hdrImage, px, vec4(hdr.rgb * transmittance + scattered, hdr.a));
}
