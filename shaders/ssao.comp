#version 450

layout(local_size_x = 8, local_size_y = 8) in;

// Depth of the WHOLE scene, written by this same frame's depth pre-pass.
// NEAREST: linear filtering on D32_SFLOAT is not mandatory in Vulkan and
// here it adds nothing, each tap wants the exact texel.
layout(set = 0, binding = 0) uniform sampler2D depthTex;
layout(set = 0, binding = 1, r32f) uniform writeonly image2D outAo;

// Specific to this pipeline: the UBO block is declared in 5 shaders and adding
// a member would silently shift everything behind it under std140, and PushData
// (the pbr/triangle/outline one) is full at exactly 80 bytes.
layout(push_constant) uniform SsaoPush {
    // p00, p11, p22, p32 of the frame's projection. With these four
    // coefficients the view space position is reconstructed and projected
    // again, without bringing in the two whole matrices.
    vec4  projParams;
    vec2  invRes;
    float radius;
    float bias;
    float intensity;
    float power;
} push;

#define SSAO_SAMPLES 16
const float PI = 3.14159265359;

// view space z (negative) from Vulkan's depth [0,1]:
// depth = (p22*z + p32) / -z  ->  z = p32 / (-depth - p22).
float viewZ(float d)
{
    return push.projParams.w / (-d - push.projParams.z);
}

// uv in [0,1] over the framebuffer -> view space position.
// The SIGN of p11 does not matter, and it is worth knowing because the two backends send
// OPPOSITE signs: Vulkan the one from its projection with Y-flip, DirectX 12 the one from
// its own without flip. Even so the image comes out identical, verified by comparing the two.
//
// It cancels out because this pass never leaves screen space: it reconstructs
// with p11, takes the normal from the reconstructed positions THEMSELVES and reprojects
// with the SAME p11, so sp.y * p11 does not change when both are inverted. Inverting
// the sign "to make it match the comment" fixes nothing and may break it.
//
// What DOES depend on the sign is any pass that goes out to world space with
// the full matrix: there the inversion has nothing to cancel against and must be
// put in explicitly (see fog.comp and H62 in docs/renderer-audit.md).
vec3 viewPos(vec2 uv, float d)
{
    float z   = viewZ(d);
    vec2  ndc = uv * 2.0 - 1.0;
    return vec3(ndc.x * (-z) / push.projParams.x,
                ndc.y * (-z) / push.projParams.y,
                z);
}

float hash1(float n)
{
    return fract(sin(n * 127.1) * 43758.5453123);
}

float hash2(vec2 p)
{
    return fract(sin(dot(p, vec2(12.9898, 78.233))) * 43758.5453123);
}

// Procedural kernel: +Z hemisphere with the samples clustered near the origin
// (quadratic weight), which is where contact AO has its signal. It goes here and
// not in a new buffer because it is constant and fits in a few ALU ops.
vec3 kernelSample(int i)
{
    float a = hash1(float(i) * 3.0 + 0.0) * 2.0 - 1.0;
    float b = hash1(float(i) * 3.0 + 1.0) * 2.0 - 1.0;
    float c = hash1(float(i) * 3.0 + 2.0);
    vec3  v = normalize(vec3(a, b, max(c, 0.05)));
    float t = float(i) / float(SSAO_SAMPLES);
    return v * mix(0.1, 1.0, t * t);
}

void main()
{
    ivec2 px   = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outAo);
    if (px.x >= size.x || px.y >= size.y) return;

    vec2  uv = (vec2(px) + 0.5) * push.invRes;
    float d  = texture(depthTex, uv).r;

    // Background: without geometry there is nothing to occlude, and the reconstruction divides
    // by zero right there.
    if (d >= 1.0)
    {
        imageStore(outAo, px, vec4(1.0));
        return;
    }

    vec3 P = viewPos(uv, d);

    // Normal reconstructed from the depth itself: of the two neighbors on each axis it
    // keeps the one with the smaller depth jump, which is the one still
    // on the SAME surface. With the plain central difference, a pixel at the
    // edge of a silhouette would mix two surfaces and produce a normal that does not
    // exist. This way no normals attachment is needed nor touching the geometry
    // pipelines.
    vec2 tx = vec2(push.invRes.x, 0.0);
    vec2 ty = vec2(0.0, push.invRes.y);
    vec3 pR = viewPos(uv + tx, texture(depthTex, uv + tx).r);
    vec3 pL = viewPos(uv - tx, texture(depthTex, uv - tx).r);
    vec3 pD = viewPos(uv + ty, texture(depthTex, uv + ty).r);
    vec3 pU = viewPos(uv - ty, texture(depthTex, uv - ty).r);

    vec3 dx = (abs(pR.z - P.z) < abs(P.z - pL.z)) ? (pR - P) : (P - pL);
    vec3 dy = (abs(pD.z - P.z) < abs(P.z - pU.z)) ? (pD - P) : (P - pU);

    vec3 N = cross(dx, dy);
    if (dot(N, N) < 1e-12)
    {
        imageStore(outAo, px, vec4(1.0));
        return;
    }
    N = normalize(N);
    // A visible surface has its geometric normal facing the camera.
    if (dot(N, P) > 0.0) N = -N;

    // Different rotation per pixel: without it the 16 rays would be the same across
    // the whole screen and the AO would come out in bands. The blur afterwards is what
    // turns this noise into a gradient.
    float ang = hash2(vec2(px)) * 2.0 * PI;
    vec3  rv  = vec3(cos(ang), sin(ang), 0.0);
    vec3  T   = normalize(rv - N * dot(rv, N));
    vec3  B   = cross(N, T);
    mat3  TBN = mat3(T, B, N);

    float occ = 0.0;
    for (int i = 0; i < SSAO_SAMPLES; i++)
    {
        vec3 sp = P + (TBN * kernelSample(i)) * push.radius;
        if (sp.z >= 0.0) continue;              // behind the camera plane

        // Reprojection with the same coefficients: clip.w = -z.
        vec2 sclip = vec2(sp.x * push.projParams.x, sp.y * push.projParams.y);
        vec2 suv   = (sclip / -sp.z) * 0.5 + 0.5;
        if (suv.x < 0.0 || suv.x > 1.0 || suv.y < 0.0 || suv.y > 1.0) continue;

        float sd = texture(depthTex, suv).r;
        if (sd >= 1.0) continue;
        float sceneZ = viewZ(sd);

        // In RH view space the camera looks at -Z: closer = greater z. If what is
        // drawn is in front of the sample, the sample is covered.
        if (sceneZ >= sp.z + push.bias)
        {
            // A very distant object that falls on the same pixel must not occlude: without
            // this, a wall in the background would darken the edge of what is in
            // front of it.
            occ += smoothstep(0.0, 1.0, push.radius / max(abs(P.z - sceneZ), 1e-4));
        }
    }

    float ao = 1.0 - (occ / float(SSAO_SAMPLES)) * push.intensity;
    ao = pow(clamp(ao, 0.0, 1.0), max(push.power, 1e-3));
    imageStore(outAo, px, vec4(ao));
}
