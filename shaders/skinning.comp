#version 450
layout(local_size_x = 64) in;

struct InputVertex {
    vec4  position;
    vec4  normal;
    vec4  tangent;
    vec4  uv_pad;
    vec4  color;
    ivec4 boneIndices;
    vec4  boneWeights;
};

struct OutputVertex {
    vec4 pos;
    vec4 color;
    vec4 uv;
    vec4 normal;
    vec4 tangent;
};

layout(set=0, binding=5, std430) readonly buffer FinalBones  { mat4 data[]; }         finalBones;
layout(set=0, binding=6, std430) readonly buffer InputVerts  { InputVertex data[]; }  inputVerts;
layout(set=0, binding=7, std430) buffer OutputVerts          { OutputVertex data[]; } outputVerts;

layout(push_constant) uniform PC {
    uint boneCount;
    uint vertexCount;
    // --- Solo los lee bone_eval.comp (ver allí) ---
    uint rootMotionMode;
    uint poseBlockOffset;
    // --- bone_ik.comp y bone_hierarchy.comp ---
    uint ikBlockOffset;   // en uints: copia del bloque de IK de este frame
    uint flags;           // bit 0: la jerarquía escribe SOLO mundo (para bone_ik)
} push;

void main()
{
    uint vi = gl_GlobalInvocationID.x;
    if (vi >= push.vertexCount) return;

    InputVertex v = inputVerts.data[vi];

    mat4  skin  = mat4(0.0);
    float total = 0.0;
    for (int i = 0; i < 4; i++)
    {
        float w = v.boneWeights[i];
        if (w > 0.0) { skin += w * finalBones.data[v.boneIndices[i]]; total += w; }
    }
    // Vértice sin ningún hueso: `skin` sería mat4(0) y lo mandaría al ORIGEN,
    // estirando la malla hasta allí. El cargador normaliza los pesos y escribe
    // cuatro ceros cuando el FBX no pesa ese vértice (ModelLoader.cpp: el
    // ternario de totalW), así que el dato puede llegar aquí perfectamente.
    // Con identidad el vértice se queda donde está en espacio de modelo, que es
    // lo que se ve como "esa parte no está animada" en vez de como un pincho.
    if (total <= 0.0) skin = mat4(1.0);

    outputVerts.data[vi].pos     = skin * vec4(v.position.xyz, 1.0);
    outputVerts.data[vi].color   = v.color;
    outputVerts.data[vi].uv      = v.uv_pad;
    outputVerts.data[vi].normal  = normalize(skin * vec4(v.normal.xyz,  0.0));
    outputVerts.data[vi].tangent = normalize(skin * vec4(v.tangent.xyz, 0.0));
}