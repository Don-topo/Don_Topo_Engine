#version 450
// One workgroup per character (the dispatch is still 1,1,1). Before it was a
// single thread walking all the bones serially: 1.93 ms of 11.16 with 30
// characters (docs/animation-audit.md, row 10).
layout(local_size_x = 64) in;

// std430 layout, mirror of GpuBoneInfo (engine/include/DonTopo/Renderer/SkinnedMesh.h)
// and of the same struct in bone_eval.comp. This shader does not read bindLocal, but the
// field has to be there anyway: they share the same SSBO (binding 3) and
// omitting it would shift the read of inverseBindPose of the following bones.
struct BoneInfo {
    int posOffset, posCount;
    int rotOffset, rotCount;
    int scaleOffset, scaleCount;
    int parentIndex, depth;
    mat4 inverseBindPose;
    mat4 bindLocal;
};

layout(set=0, binding=3, std430) readonly buffer BoneInfos   { BoneInfo data[]; } boneInfos;
layout(set=0, binding=4, std430) readonly buffer LocalXforms { mat4 data[]; }     localXforms;
layout(set=0, binding=5, std430) buffer FinalBones           { mat4 data[]; }     finalBones;

layout(push_constant) uniform PC {
    uint boneCount;
    uint vertexCount;
    // --- Only read by bone_eval.comp (see there) ---
    uint rootMotionMode;
    uint poseBlockOffset;
    // --- bone_ik.comp y bone_hierarchy.comp ---
    uint ikBlockOffset;   // in uints: copy of this frame's IK block
    uint flags;           // bit 0: the hierarchy writes ONLY world (for bone_ik)
} push;

shared uint sMaxDepth;

void main()
{
    const uint t = gl_LocalInvocationID.x;

    // Maximum depth of the skeleton, reduced in shared memory: there is no free
    // slot in the push constant (the ones left are used by bone_eval).
    if (t == 0u) sMaxDepth = 0u;
    barrier();
    for (uint i = t; i < push.boneCount; i += 64u)
        atomicMax(sMaxDepth, uint(boneInfos.data[i].depth));
    barrier();
    const uint maxDepth = sMaxDepth;

    // Pass 1: world transform, level by level. All the bones of a level
    // are independent of each other; the parent is in the previous level, already
    // written and visible after the barrier. maxDepth is uniform across the workgroup,
    // so all the threads reach the same barriers.
    for (uint d = 0u; d <= maxDepth; d++)
    {
        for (uint i = t; i < push.boneCount; i += 64u)
        {
            if (uint(boneInfos.data[i].depth) != d) continue;
            int parent = boneInfos.data[i].parentIndex;
            finalBones.data[i] = (parent < 0)
                ? localXforms.data[i]
                : finalBones.data[parent] * localXforms.data[i];
        }
        memoryBarrierBuffer();
        barrier();
    }

    // Pass 2: inverse bind pose, independent bone by bone. It goes after
    // the last barrier: it overwrites in place and nobody reads the world one anymore.
    //
    // With bit 0 of flags it is NOT done: bone_ik needs the WORLD transforms,
    // so for characters with IK this shader runs twice:
    // the first time world only, and the second (already with the corrected locals)
    // in full.
    if ((push.flags & 1u) != 0u) return;
    for (uint i = t; i < push.boneCount; i += 64u)
        finalBones.data[i] = finalBones.data[i] * boneInfos.data[i].inverseBindPose;
}