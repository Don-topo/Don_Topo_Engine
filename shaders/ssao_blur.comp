#version 450

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform sampler2D aoTex;
layout(set = 0, binding = 1, r32f) uniform writeonly image2D outAo;

// Same block as ssao.comp: they share pipeline layout, so the push
// constants range has to match. Here only invRes is used.
layout(push_constant) uniform SsaoPush {
    vec4  projParams;
    vec2  invRes;
    float radius;
    float bias;
    float intensity;
    float power;
} push;

void main()
{
    ivec2 px   = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(outAo);
    if (px.x >= size.x || px.y >= size.y) return;

    // 4x4 box, which is exactly the period of ssao.comp's rotation noise: each
    // pixel of the result averages the 16 orientations and the pattern disappears
    // completely. With a smaller box the grid pattern would remain visible.
    float sum = 0.0;
    for (int y = -2; y <= 1; y++)
        for (int x = -2; x <= 1; x++)
            sum += texture(aoTex, (vec2(px) + 0.5 + vec2(x, y)) * push.invRes).r;

    imageStore(outAo, px, vec4(sum / 16.0));
}
