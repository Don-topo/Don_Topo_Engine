#version 450
layout(local_size_x = 64) in;

struct PosKey  { vec4 timePad; vec4 value; };
struct RotKey  { vec4 timePad; vec4 quat;  };
// Layout std430, espejo de GpuBoneInfo (engine/include/DonTopo/Renderer/SkinnedMesh.h)
// y del mismo struct en bone_hierarchy.comp. Los tres tienen que coincidir campo
// a campo y en el mismo orden.
struct BoneInfo {
    int posOffset, posCount;
    int rotOffset, rotCount;
    int scaleOffset, scaleCount;
    int parentIndex, depth;   // depth: solo lo lee bone_hierarchy
    mat4 inverseBindPose;
    mat4 bindLocal;
};

layout(set=0, binding=0, std430) readonly buffer PosKeys    { PosKey  data[]; } posKeys;
layout(set=0, binding=1, std430) readonly buffer RotKeys    { RotKey  data[]; } rotKeys;
layout(set=0, binding=2, std430) readonly buffer ScaleKeys  { PosKey  data[]; } scaleKeys;
layout(set=0, binding=3, std430) readonly buffer BoneInfos  { BoneInfo data[]; } boneInfos;
layout(set=0, binding=4, std430) buffer LocalXforms         { mat4 data[]; } localXforms;
// Pose resultante en TRS, 3 vec4 por hueso (pos, rot, escala). escala.w = 0
// marca "este hueso vale su bindLocal" (ninguna muestra lo anima). La copia a
// frozenTrs al interrumpir un fade es la pose congelada del siguiente.
layout(set=0, binding=8, std430) buffer PoseTrs             { vec4 data[]; } poseTrs;
layout(set=0, binding=9, std430) readonly buffer FrozenTrs  { vec4 data[]; } frozenTrs;

layout(push_constant) uniform PC {
    uint  boneCount;
    uint  vertexCount;
    // --- Solo los lee bone_eval.comp ---
    // Hasta 4 muestras (clip * boneCount, tiempo en ticks, peso) y el peso de
    // la pose congelada. Escalares y no arrays: en HLSL un array de un cbuffer
    // ocupa 16 bytes por elemento, y spirv-cross no lo iguala. El mismo bloque
    // en los tres .comp, en SkinningPass::Push y en ComputePush de D3D12.
    uint  sampleCount;
    uint  rootMotionMode;   // 0 libre, 1 raíz clavada a bind, 2 solo X y Z
    float frozenWeight;
    uint  clipBase0; uint clipBase1; uint clipBase2; uint clipBase3;
    float time0;     float time1;    float time2;    float time3;
    float weight0;   float weight1;  float weight2;  float weight3;
} push;

vec4 slerpQ(vec4 a, vec4 b, float t)
{
    float c = dot(a, b);
    if (c < 0.0) { b = -b; c = -c; }
    if (c > 0.9995) return normalize(mix(a, b, t));
    float angle = acos(c);
    float is    = 1.0 / sin(angle);
    return (sin((1.0 - t) * angle) * a + sin(t * angle) * b) * is;
}

mat4 trs(vec3 t, vec4 q, vec3 s)
{
    float x=q.x, y=q.y, z=q.z, w=q.w;
    float xx=x*x, yy=y*y, zz=z*z;
    float xy=x*y, xz=x*z, yz=y*z;
    float wx=w*x, wy=w*y, wz=w*z;
    float r00=1.0-2.0*(yy+zz), r10=2.0*(xy+wz), r20=2.0*(xz-wy);
    float r01=2.0*(xy-wz),     r11=1.0-2.0*(xx+zz), r21=2.0*(yz+wx);
    float r02=2.0*(xz+wy),     r12=2.0*(yz-wx),     r22=1.0-2.0*(xx+yy);
    return mat4(
        r00*s.x, r10*s.x, r20*s.x, 0.0,
        r01*s.y, r11*s.y, r21*s.y, 0.0,
        r02*s.z, r12*s.z, r22*s.z, 0.0,
        t.x, t.y, t.z, 1.0
    );
}

// Muestrea el hueso descrito por info en el instante T. Sale por referencia
// porque el cross-fade necesita las TRES componentes por separado para
// mezclarlas antes de componer la matriz: mezclar dos matrices ya compuestas
// interpola la rotación por sus columnas y deja poses torcidas en cuanto los
// dos clips no miran casi al mismo sitio.
void sampleBone(BoneInfo info, float T, out vec3 pos, out vec4 rot, out vec3 scl)
{
    pos = vec3(0.0);
    rot = vec4(0.0, 0.0, 0.0, 1.0);
    scl = vec3(1.0);

    if (info.posCount > 0)
    {
        int lo = info.posOffset, hi = info.posOffset + info.posCount - 1;
        for (int k = info.posOffset; k < info.posOffset + info.posCount - 1; k++)
            if (posKeys.data[k+1].timePad.x > T) { lo = k; hi = k+1; break; }
        float t0 = posKeys.data[lo].timePad.x, t1 = posKeys.data[hi].timePad.x;
        float f  = (t1 > t0) ? clamp((T - t0)/(t1 - t0), 0.0, 1.0) : 0.0;
        pos = mix(posKeys.data[lo].value.xyz, posKeys.data[hi].value.xyz, f);
    }

    if (info.rotCount > 0)
    {
        int lo = info.rotOffset, hi = info.rotOffset + info.rotCount - 1;
        for (int k = info.rotOffset; k < info.rotOffset + info.rotCount - 1; k++)
            if (rotKeys.data[k+1].timePad.x > T) { lo = k; hi = k+1; break; }
        float t0 = rotKeys.data[lo].timePad.x, t1 = rotKeys.data[hi].timePad.x;
        float f  = (t1 > t0) ? clamp((T - t0)/(t1 - t0), 0.0, 1.0) : 0.0;
        rot = slerpQ(rotKeys.data[lo].quat, rotKeys.data[hi].quat, f);
    }

    if (info.scaleCount > 0)
    {
        int lo = info.scaleOffset, hi = info.scaleOffset + info.scaleCount - 1;
        for (int k = info.scaleOffset; k < info.scaleOffset + info.scaleCount - 1; k++)
            if (scaleKeys.data[k+1].timePad.x > T) { lo = k; hi = k+1; break; }
        float t0 = scaleKeys.data[lo].timePad.x, t1 = scaleKeys.data[hi].timePad.x;
        float f  = (t1 > t0) ? clamp((T - t0)/(t1 - t0), 0.0, 1.0) : 0.0;
        scl = mix(scaleKeys.data[lo].value.xyz, scaleKeys.data[hi].value.xyz, f);
    }
}

// Único punto de override de la raíz, sobre la posición ya mezclada.
// rootMotionMode 1 clava toda la traslación a la de bind (el clip en el sitio);
// 2 (root motion) clava solo X y Z, la Y se queda para que el vaivén del paso se
// vea y el avance lo pone el GameObject. Cualquier otro hueso sale tal cual.
vec3 applyRootLock(BoneInfo info, vec3 pos)
{
    if (info.parentIndex >= 0) return pos;
    if (push.rootMotionMode == 1u) return info.bindLocal[3].xyz;
    if (push.rootMotionMode == 2u) return vec3(info.bindLocal[3].x, pos.y, info.bindLocal[3].z);
    return pos;
}

bool boneHasNoChannel(BoneInfo info)
{
    return info.posCount == 0 && info.rotCount == 0 && info.scaleCount == 0;
}

void muestra(uint k, out uint cb, out float t, out float w)
{
    if (k == 0u)      { cb = push.clipBase0; t = push.time0; w = push.weight0; }
    else if (k == 1u) { cb = push.clipBase1; t = push.time1; w = push.weight1; }
    else if (k == 2u) { cb = push.clipBase2; t = push.time2; w = push.weight2; }
    else              { cb = push.clipBase3; t = push.time3; w = push.weight3; }
}

void main()
{
    uint bi = gl_GlobalInvocationID.x;
    if (bi >= push.boneCount) return;

    // Suma ponderada de hasta 4 muestras y de la pose congelada: posición y
    // escala lineales, rotación con el signo alineado a la primera y normalizada
    // al final (nlerp). Así un fade desde un estado con blend aporta su pareja
    // entera (A3) y una interrupción sale de la pose que había (A4). Réplica en
    // CPU: evalPoseTrs en animator_tests.cpp.
    vec3  pos = vec3(0.0);
    vec3  scl = vec3(0.0);
    vec4  q   = vec4(0.0);
    vec4  ref = vec4(0.0, 0.0, 0.0, 1.0);
    bool  hayRef = false;
    bool  alguna = false;
    float total  = 0.0;
    // parentIndex y bindLocal son del esqueleto: iguales en todos los bloques.
    BoneInfo info0 = boneInfos.data[push.clipBase0 + bi];

    for (uint k = 0u; k < push.sampleCount; k++)
    {
        uint cb; float t; float w;
        muestra(k, cb, t, w);
        BoneInfo info = boneInfos.data[cb + bi];
        vec3 p = vec3(0.0);
        vec4 r = vec4(0.0, 0.0, 0.0, 1.0);
        vec3 s = vec3(1.0);
        // Una muestra sin canal en este hueso aporta TRS identidad, como la
        // mezcla de dos clips de siempre.
        if (!boneHasNoChannel(info)) { sampleBone(info, t, p, r, s); alguna = true; }
        if (!hayRef) { ref = r; hayRef = true; }
        if (dot(r, ref) < 0.0) r = -r;
        pos += w * p; scl += w * s; q += w * r; total += w;
    }

    if (push.frozenWeight > 0.0)
    {
        vec4 fp = frozenTrs.data[bi * 3u + 0u];
        vec4 fr = frozenTrs.data[bi * 3u + 1u];
        vec4 fs = frozenTrs.data[bi * 3u + 2u];
        // Si el hueso congelado era "bind", no entra: el resto se renormaliza.
        if (fs.w != 0.0)
        {
            float w = push.frozenWeight;
            if (!hayRef) { ref = fr; hayRef = true; }
            if (dot(fr, ref) < 0.0) fr = -fr;
            pos += w * fp.xyz; scl += w * fs.xyz; q += w * fr; total += w;
            alguna = true;
        }
    }

    // Ninguna muestra dice nada de este hueso: conserva su local de bind pose
    // (con la identidad colapsaría sobre su padre y arrastraría su cadena).
    if (!alguna)
    {
        localXforms.data[bi] = info0.bindLocal;
        poseTrs.data[bi * 3u + 0u] = vec4(0.0);
        poseTrs.data[bi * 3u + 1u] = vec4(0.0, 0.0, 0.0, 1.0);
        poseTrs.data[bi * 3u + 2u] = vec4(1.0, 1.0, 1.0, 0.0);
        return;
    }

    if (total > 0.0 && abs(total - 1.0) > 1e-4) { pos /= total; scl /= total; q /= total; }
    float len = length(q);
    q = len > 1e-6 ? q / len : vec4(0.0, 0.0, 0.0, 1.0);
    pos = applyRootLock(info0, pos);

    localXforms.data[bi] = trs(pos, q, scl);
    poseTrs.data[bi * 3u + 0u] = vec4(pos, 0.0);
    poseTrs.data[bi * 3u + 1u] = q;
    poseTrs.data[bi * 3u + 2u] = vec4(scl, 1.0);
}
