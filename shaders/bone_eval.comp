#version 450
layout(local_size_x = 64) in;

struct PosKey  { vec4 timePad; vec4 value; };
struct RotKey  { vec4 timePad; vec4 quat;  };
// Layout std430, espejo de GpuBoneInfo (engine/include/DonTopo/Renderer/SkinnedMesh.h)
// y del mismo struct en bone_hierarchy.comp. Los tres tienen que coincidir campo
// a campo y en el mismo orden.
struct BoneInfo {
    int posOffset, posCount;
    int rotOffset, rotCount;
    int scaleOffset, scaleCount;
    int parentIndex, depth;   // depth: solo lo lee bone_hierarchy
    mat4 inverseBindPose;
    mat4 bindLocal;
};

layout(set=0, binding=0, std430) readonly buffer PosKeys    { PosKey  data[]; } posKeys;
layout(set=0, binding=1, std430) readonly buffer RotKeys    { RotKey  data[]; } rotKeys;
layout(set=0, binding=2, std430) readonly buffer ScaleKeys  { PosKey  data[]; } scaleKeys;
layout(set=0, binding=3, std430) readonly buffer BoneInfos  { BoneInfo data[]; } boneInfos;
layout(set=0, binding=4, std430) buffer LocalXforms         { mat4 data[]; } localXforms;
// Pose de cada CAPA en TRS, 3 vec4 por hueso (pos, rot, escala), un bloque de
// boneCount por capa. escala.w = 0 marca "esta capa no anima el hueso". La de
// una capa additive es su delta. La copia a frozenTrs al interrumpir un fade
// es la pose congelada del siguiente, capa a capa.
layout(set=0, binding=8, std430) buffer PoseTrs             { vec4 data[]; } poseTrs;
layout(set=0, binding=9, std430) readonly buffer FrozenTrs  { vec4 data[]; } frozenTrs;
// Bloque de pose (capas, muestras, máscaras), una copia por frame en vuelo.
// Layout en engine/include/DonTopo/Renderer/PoseBlock.h.
layout(set=0, binding=10, std430) readonly buffer PoseBlock { uint data[]; } poseBlock;

layout(push_constant) uniform PC {
    uint boneCount;
    uint vertexCount;
    // --- Solo los lee bone_eval.comp ---
    uint rootMotionMode;    // 0 libre, 1 raíz clavada a bind, 2 solo X y Z
    // Offset (en uints) de la copia de este frame del bloque de pose. El mismo
    // bloque de 24 bytes en los cuatro .comp, en SkinningPass::Push y en
    // ComputePush de D3D12.
    uint poseBlockOffset;
    // --- bone_ik.comp y bone_hierarchy.comp (ver allí) ---
    uint ikBlockOffset;
    uint flags;
} push;

vec4 slerpQ(vec4 a, vec4 b, float t)
{
    float c = dot(a, b);
    if (c < 0.0) { b = -b; c = -c; }
    if (c > 0.9995) return normalize(mix(a, b, t));
    float angle = acos(c);
    float is    = 1.0 / sin(angle);
    return (sin((1.0 - t) * angle) * a + sin(t * angle) * b) * is;
}

mat4 trs(vec3 t, vec4 q, vec3 s)
{
    float x=q.x, y=q.y, z=q.z, w=q.w;
    float xx=x*x, yy=y*y, zz=z*z;
    float xy=x*y, xz=x*z, yz=y*z;
    float wx=w*x, wy=w*y, wz=w*z;
    float r00=1.0-2.0*(yy+zz), r10=2.0*(xy+wz), r20=2.0*(xz-wy);
    float r01=2.0*(xy-wz),     r11=1.0-2.0*(xx+zz), r21=2.0*(yz+wx);
    float r02=2.0*(xz+wy),     r12=2.0*(yz-wx),     r22=1.0-2.0*(xx+yy);
    return mat4(
        r00*s.x, r10*s.x, r20*s.x, 0.0,
        r01*s.y, r11*s.y, r21*s.y, 0.0,
        r02*s.z, r12*s.z, r22*s.z, 0.0,
        t.x, t.y, t.z, 1.0
    );
}

// Muestrea el hueso descrito por info en el instante T. Sale por referencia
// porque el cross-fade necesita las TRES componentes por separado para
// mezclarlas antes de componer la matriz: mezclar dos matrices ya compuestas
// interpola la rotación por sus columnas y deja poses torcidas en cuanto los
// dos clips no miran casi al mismo sitio.
void sampleBone(BoneInfo info, float T, out vec3 pos, out vec4 rot, out vec3 scl)
{
    pos = vec3(0.0);
    rot = vec4(0.0, 0.0, 0.0, 1.0);
    scl = vec3(1.0);

    if (info.posCount > 0)
    {
        int lo = info.posOffset, hi = info.posOffset + info.posCount - 1;
        for (int k = info.posOffset; k < info.posOffset + info.posCount - 1; k++)
            if (posKeys.data[k+1].timePad.x > T) { lo = k; hi = k+1; break; }
        float t0 = posKeys.data[lo].timePad.x, t1 = posKeys.data[hi].timePad.x;
        float f  = (t1 > t0) ? clamp((T - t0)/(t1 - t0), 0.0, 1.0) : 0.0;
        pos = mix(posKeys.data[lo].value.xyz, posKeys.data[hi].value.xyz, f);
    }

    if (info.rotCount > 0)
    {
        int lo = info.rotOffset, hi = info.rotOffset + info.rotCount - 1;
        for (int k = info.rotOffset; k < info.rotOffset + info.rotCount - 1; k++)
            if (rotKeys.data[k+1].timePad.x > T) { lo = k; hi = k+1; break; }
        float t0 = rotKeys.data[lo].timePad.x, t1 = rotKeys.data[hi].timePad.x;
        float f  = (t1 > t0) ? clamp((T - t0)/(t1 - t0), 0.0, 1.0) : 0.0;
        rot = slerpQ(rotKeys.data[lo].quat, rotKeys.data[hi].quat, f);
    }

    if (info.scaleCount > 0)
    {
        int lo = info.scaleOffset, hi = info.scaleOffset + info.scaleCount - 1;
        for (int k = info.scaleOffset; k < info.scaleOffset + info.scaleCount - 1; k++)
            if (scaleKeys.data[k+1].timePad.x > T) { lo = k; hi = k+1; break; }
        float t0 = scaleKeys.data[lo].timePad.x, t1 = scaleKeys.data[hi].timePad.x;
        float f  = (t1 > t0) ? clamp((T - t0)/(t1 - t0), 0.0, 1.0) : 0.0;
        scl = mix(scaleKeys.data[lo].value.xyz, scaleKeys.data[hi].value.xyz, f);
    }
}

// Único punto de override de la raíz, sobre la posición ya mezclada.
// rootMotionMode 1 clava toda la traslación a la de bind (el clip en el sitio);
// 2 (root motion) clava solo X y Z, la Y se queda para que el vaivén del paso se
// vea y el avance lo pone el GameObject. Cualquier otro hueso sale tal cual.
vec3 applyRootLock(BoneInfo info, vec3 pos)
{
    if (info.parentIndex >= 0) return pos;
    if (push.rootMotionMode == 1u) return info.bindLocal[3].xyz;
    if (push.rootMotionMode == 2u) return vec3(info.bindLocal[3].x, pos.y, info.bindLocal[3].z);
    return pos;
}

bool boneHasNoChannel(BoneInfo info)
{
    return info.posCount == 0 && info.rotCount == 0 && info.scaleCount == 0;
}

// Offsets del bloque de pose: los mismos que PoseBlock.h.
const uint kLayers  = 4u;
const uint kSamples = 36u;
const uint kMasks   = 228u;
uint  pb(uint i)  { return poseBlock.data[push.poseBlockOffset + i]; }
float pbf(uint i) { return uintBitsToFloat(pb(i)); }

vec4 qmul(vec4 a, vec4 b)
{
    return vec4(a.w * b.xyz + b.w * a.xyz + cross(a.xyz, b.xyz), a.w * b.w - dot(a.xyz, b.xyz));
}

// Inversa de trs(): escala = longitud de las columnas, rotación de las columnas
// normalizadas. Solo para el bindLocal de un hueso que la base no anima y sobre
// el que una capa sí actúa.
void decomposeTrs(mat4 m, out vec3 pos, out vec4 q, out vec3 scl)
{
    pos = m[3].xyz;
    scl = vec3(length(m[0].xyz), length(m[1].xyz), length(m[2].xyz));
    mat3 r = mat3(m[0].xyz / max(scl.x, 1e-8), m[1].xyz / max(scl.y, 1e-8), m[2].xyz / max(scl.z, 1e-8));
    float tr = r[0][0] + r[1][1] + r[2][2];
    if (tr > 0.0)
    {
        float s = sqrt(tr + 1.0) * 2.0;
        q = vec4((r[1][2] - r[2][1]) / s, (r[2][0] - r[0][2]) / s, (r[0][1] - r[1][0]) / s, 0.25 * s);
    }
    else if (r[0][0] > r[1][1] && r[0][0] > r[2][2])
    {
        float s = sqrt(1.0 + r[0][0] - r[1][1] - r[2][2]) * 2.0;
        q = vec4(0.25 * s, (r[1][0] + r[0][1]) / s, (r[2][0] + r[0][2]) / s, (r[1][2] - r[2][1]) / s);
    }
    else if (r[1][1] > r[2][2])
    {
        float s = sqrt(1.0 + r[1][1] - r[0][0] - r[2][2]) * 2.0;
        q = vec4((r[1][0] + r[0][1]) / s, 0.25 * s, (r[2][1] + r[1][2]) / s, (r[2][0] - r[0][2]) / s);
    }
    else
    {
        float s = sqrt(1.0 + r[2][2] - r[0][0] - r[1][1]) * 2.0;
        q = vec4((r[2][0] + r[0][2]) / s, (r[2][1] + r[1][2]) / s, 0.25 * s, (r[0][1] - r[1][0]) / s);
    }
    q = normalize(q);
}

// La pose de la capa L para el hueso bi: suma ponderada de sus muestras y de
// su congelada (posición y escala lineales, rotación con el signo alineado y
// normalizada: nlerp). En additive cada muestra aporta su delta respecto al
// primer fotograma de su clip, y la referencia del signo es la identidad.
// Escribe la pose de la capa en poseTrs (lo que congela un fade). Devuelve
// false si es override y ninguna muestra anima el hueso. Réplica en CPU:
// capaTrs en animator_tests.cpp.
bool evalCapa(uint L, bool additive, uint bi, out vec3 pos, out vec4 q, out vec3 scl)
{
    pos = vec3(0.0);
    scl = vec3(0.0);
    q   = vec4(0.0);
    vec4  ref    = vec4(0.0, 0.0, 0.0, 1.0);
    bool  hayRef = additive;
    bool  alguna = false;
    float total  = 0.0;
    uint  n      = pb(1u);
    for (uint k = 0u; k < n; k++)
    {
        uint o = kSamples + 4u * k;
        if (pb(o + 3u) != L) continue;
        uint  cb = pb(o);
        float t  = pbf(o + 1u);
        float w  = pbf(o + 2u);
        BoneInfo info = boneInfos.data[cb + bi];
        vec3 p = vec3(0.0);
        vec4 r = vec4(0.0, 0.0, 0.0, 1.0);
        vec3 s = vec3(1.0);
        // Una muestra sin canal en este hueso aporta TRS identidad (en
        // additive, delta identidad), como la mezcla de dos clips de siempre.
        if (!boneHasNoChannel(info))
        {
            sampleBone(info, t, p, r, s);
            alguna = true;
            if (additive)
            {
                vec3 p0; vec4 r0; vec3 s0;
                sampleBone(info, 0.0, p0, r0, s0);
                p = p - p0;
                r = qmul(r, vec4(-r0.xyz, r0.w));
                s = vec3(s0.x != 0.0 ? s.x / s0.x : 1.0,
                         s0.y != 0.0 ? s.y / s0.y : 1.0,
                         s0.z != 0.0 ? s.z / s0.z : 1.0);
            }
        }
        if (!hayRef) { ref = r; hayRef = true; }
        if (dot(r, ref) < 0.0) r = -r;
        pos += w * p; scl += w * s; q += w * r; total += w;
    }

    uint  base = (L * push.boneCount + bi) * 3u;
    float fw   = pbf(kLayers + 4u * L + 2u);
    if (fw > 0.0)
    {
        vec4 fp = frozenTrs.data[base + 0u];
        vec4 fr = frozenTrs.data[base + 1u];
        vec4 fs = frozenTrs.data[base + 2u];
        // Si el hueso congelado no lo animaba la capa, no entra: el resto se
        // renormaliza.
        if (fs.w != 0.0)
        {
            if (!hayRef) { ref = fr; hayRef = true; }
            if (dot(fr, ref) < 0.0) fr = -fr;
            pos += fw * fp.xyz; scl += fw * fs.xyz; q += fw * fr; total += fw;
            alguna = true;
        }
    }

    if (!additive && !alguna)
    {
        pos = vec3(0.0); q = vec4(0.0, 0.0, 0.0, 1.0); scl = vec3(1.0);
        poseTrs.data[base + 0u] = vec4(0.0);
        poseTrs.data[base + 1u] = vec4(0.0, 0.0, 0.0, 1.0);
        poseTrs.data[base + 2u] = vec4(1.0, 1.0, 1.0, 0.0);
        return false;
    }
    if (total <= 0.0)
    {
        // Capa additive sin muestras: delta identidad (y no escala 0).
        pos = vec3(0.0); q = vec4(0.0, 0.0, 0.0, 1.0); scl = vec3(1.0);
    }
    else
    {
        if (abs(total - 1.0) > 1e-4) { pos /= total; scl /= total; q /= total; }
        float len = length(q);
        q = len > 1e-6 ? q / len : vec4(0.0, 0.0, 0.0, 1.0);
    }
    poseTrs.data[base + 0u] = vec4(pos, 0.0);
    poseTrs.data[base + 1u] = q;
    poseTrs.data[base + 2u] = vec4(scl, 1.0);
    return true;
}

void main()
{
    uint bi = gl_GlobalInvocationID.x;
    if (bi >= push.boneCount) return;

    // parentIndex y bindLocal son del esqueleto: iguales en todos los bloques.
    uint     cb0   = pb(1u) > 0u ? pb(kSamples) : 0u;
    BoneInfo info0 = boneInfos.data[cb0 + bi];

    // La base (capa 0), y cada capa encima, en orden, con m = peso x máscara:
    // override mezcla hacia la capa, additive le suma su delta. Réplica en
    // CPU: evalLayeredTrs en animator_tests.cpp.
    vec3 pos; vec4 q; vec3 scl;
    bool bind = !evalCapa(0u, false, bi, pos, q, scl);
    uint nL   = pb(0u);
    for (uint L = 1u; L < nL; L++)
    {
        uint  o        = kLayers + 4u * L;
        float peso     = pbf(o);
        bool  additive = pb(o + 1u) == 1u;
        bool  mascara  = pb(o + 3u) != 0u;
        vec3 lp; vec4 lq; vec3 ls;
        // Se evalúa siempre: su poseTrs es lo que congela un fade de la capa.
        bool anima = evalCapa(L, additive, bi, lp, lq, ls);
        float m = peso * (mascara ? float(pb(kMasks + L * push.boneCount + bi)) : 1.0);
        if (m <= 0.0 || !anima) continue;
        if (bind) { decomposeTrs(info0.bindLocal, pos, q, scl); bind = false; }
        if (!additive)
        {
            if (dot(lq, q) < 0.0) lq = -lq;
            pos = mix(pos, lp, m);
            scl = mix(scl, ls, m);
            q   = normalize(mix(q, lq, m));
        }
        else
        {
            if (lq.w < 0.0) lq = -lq;
            vec4 d = normalize(mix(vec4(0.0, 0.0, 0.0, 1.0), lq, m));
            q   = normalize(qmul(d, q));
            pos += m * lp;
            scl *= mix(vec3(1.0), ls, m);
        }
    }

    // Nada anima este hueso: conserva su local de bind pose (con la identidad
    // colapsaría sobre su padre y arrastraría su cadena).
    if (bind)
    {
        localXforms.data[bi] = info0.bindLocal;
        return;
    }
    pos = applyRootLock(info0, pos);
    localXforms.data[bi] = trs(pos, q, scl);
}
